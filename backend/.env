# Общие настройки
APP_NAME=PaEasy
DEBUG=True

# База данных
DATABASE_URL=sqlite:///./test_mode.db

# Настройки YOLO-NAS
YOLO_MODEL_NAME=yolo_nas_l
YOLO_NUM_CLASSES=3
YOLO_CHECKPOINT_PATH=../models/average_model.pth
YOLO_PRETRAINED_WEIGHTS=None
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_DEVICE=auto
YOLO_FUSE_MODEL=True

# Настройки загрузки файлов
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760